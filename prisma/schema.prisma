// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN @map("admin")
  USER  @map("user")

  @@map("user_role")
}

model User {
  id                 String  @id @default(dbgenerated("gen_random_uuid()"))
  role               Role
  username           String
  email              String  @unique
  password           String?
  photoUrl           String? @map("photo_url")
  isVerified         Boolean @default(false) @map("is_verified")
  resetPasswordToken String? @map("reset_password_token")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("user")
}

model Video {
  id                 String  @id @default(dbgenerated("gen_random_uuid()"))
  slug               String  @unique @default(dbgenerated("gen_random_uuid()"))
  title              String
  playlistId         String? @map("playlist_id")
  playlistWatchOrder Int?    @map("playlist_watch_order")

  malId         Int?      @unique @map("mal_id")
  titleEnglish  String?   @map("title_english")
  titleJapanese String?   @map("title_japanese")
  synopsis      String?   @db.Text
  imageUrl      String?   @map("image_url")
  largeImageUrl String?   @map("large_image_url")
  airedFrom     DateTime? @map("aired_from")
  airedTo       DateTime? @map("aired_to")
  score         Float?
  status        String?
  totalEpisodes Int?      @map("total_episodes")
  mediaType     String?   @map("media_type")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  playlist Playlist?      @relation(fields: [playlistId], references: [id])
  episodes Episode[]
  genres   VideoGenre[]
  channels VideoChannel[]

  @@map("video")
}

model Episode {
  id            String  @id @default(dbgenerated("gen_random_uuid()"))
  episodeNumber Int     @map("episode_number")
  title         String?
  videoId       String  @map("video_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  video                 Video                  @relation(fields: [videoId], references: [id])
  channelStreamEpisodes ChannelStreamEpisode[]

  @@unique([videoId, episodeNumber])
  @@map("episode")
}

model Playlist {
  id   String @id @default(dbgenerated("gen_random_uuid()"))
  name String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  videos Video[]

  @@map("playlist")
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  videos VideoGenre[]

  @@map("genre")
}

model VideoGenre {
  videoId String
  genreId Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  video Video @relation(fields: [videoId], references: [id])
  genre Genre @relation(fields: [genreId], references: [id])

  @@id([videoId, genreId])
  @@map("video_genre")
}

model Channel {
  id            String  @id @default(dbgenerated("gen_random_uuid()"))
  slug          String  @unique @default(dbgenerated("gen_random_uuid()"))
  name          String
  nameJapanese  String? @map("name_japanese")
  description   String? @db.Text
  imageUrl      String? @map("image_url")
  largeImageUrl String? @map("large_image_url")
  youtubeUrl    String? @map("youtube_url")
  twitchUrl     String? @map("twitch_url")
  xUrl          String? @map("x_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  videos         VideoChannel[]
  channelStreams ChannelStream[]

  @@map("channel")
}

model VideoChannel {
  videoId   String
  channelId String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  video   Video   @relation(fields: [videoId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@id([videoId, channelId])
  @@map("video_channel")
}

model ChannelStream {
  id        String @id @default(dbgenerated("gen_random_uuid()"))
  channelId String @map("channel_id")

  link  String
  title String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  channel  Channel                @relation(fields: [channelId], references: [id])
  episodes ChannelStreamEpisode[]

  @@map("channel_stream")
}

model ChannelStreamEpisode {
  streamId  String @map("stream_id")
  episodeId String @map("episode_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  stream  ChannelStream @relation(fields: [streamId], references: [id])
  episode Episode       @relation(fields: [episodeId], references: [id])

  @@id([streamId, episodeId])
  @@map("channel_stream_episode")
}
